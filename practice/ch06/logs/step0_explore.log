from launch import LaunchDescription
from launch_ros.actions import Node
from launch.substitutions import Command
from launch.substitutions import PathJoinSubstitution
from ament_index_python.packages import get_package_share_directory

def generate_launch_description():

    ld = LaunchDescription()

    xacro_path = 'urdf/two_joints_robot.urdf'

    robot_description = PathJoinSubstitution([
        get_package_share_directory('two_joints_robot'),	
        xacro_path
    ])

    robot_state_publisher_node = Node(
        package='robot_state_publisher',
        executable='robot_state_publisher',
        name='robot_state_publisher',
        output='screen',
        parameters=[{
            'robot_description':Command(['xacro ', robot_description])
        }]
    )
    joint_state_publisher_gui = Node(
        package='joint_state_publisher_gui',
        executable='joint_state_publisher_gui',
        name='joint_state_publisher_gui',
        output='screen')
    
    ld.add_action( joint_state_publisher_gui )
    ld.add_action( robot_state_publisher_node )

    return ld##### /home/user/ros2_books/Mastering-ROS-2-for-Robotics-Programming/Chapter06/two_joints_robot/config/controller.yaml
controller_manager:
  ros__parameters:
    update_rate: 100  # Hz

    position_control:
      type: forward_command_controller/ForwardCommandController

    velocity_control:
      type: forward_command_controller/ForwardCommandController

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

    sine_controller:
      type: sine_controller/SineController

position_control:
  ros__parameters:
    joints:
      - base_joint
      - link1_link2
    interface_name: position
    state_interfaces:
      - position
      - velocity
      

velocity_control:
  ros__parameters:
    joints:
      - base_joint
      - link1_link2
    interface_name: velocity
    state_interfaces:
      - position
      - velocity

sine_controller:
  ros__parameters:
    update_rate: 100
    joints:
      - base_joint
      - link1_link2

